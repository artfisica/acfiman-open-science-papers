{
  "name": "ACFIMAN papers \u2014 LaTeX",
  "customizations": {
    "vscode": {
      "extensions": [
        "James-Yu.latex-workshop"
      ],
      "settings": {
        "latex-workshop.latex.autoBuild.run": "never",
        "latex-workshop.view.pdf.viewer": "tab"
      }
    }
  },
  "containerEnv": {
    "PAPERS_RUNTIME": "ghcr.io/xu-cheng/texlive-debian@sha256:78ac2204b8df113aca0561e8f173ad5b89ee51e90795173d2fe9bcf0fbce162e"
  },
  "remoteUser": "vscode",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "TEX_IMAGE": "ghcr.io/xu-cheng/texlive-debian@sha256:78ac2204b8df113aca0561e8f173ad5b89ee51e90795173d2fe9bcf0fbce162e"
    }
  }
}
